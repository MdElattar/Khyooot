# Copy to .env and supply real values on the server. Never commit .env.
PORT=4000
NODE_ENV=production

# MongoDB connection string (credentials must come from the secret manager)
MONGODB_URI=<mongodb-connection-string>

# At least 32 characters; rotate this value when deploying.
JWT_SECRET=<long-random-secret>
USER_TOKEN_TTL=7d
ADMIN_TOKEN_TTL=12h

# Admin credentials. Prefer the bcrypt hash; leave ADMIN_PASSWORD unset once set.
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD_HASH=<bcrypt-hash-of-admin-password>
# ADMIN_PASSWORD=<only-for-legacy-compatibility>

# Cloudinary
CLOUDINARY_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_SECRET_KEY=<api-secret>

# SMTP sender used for reset codes
SENDER_EMAIL=<sender-email>
SENDER_EMAIL_PASSWORD=<smtp-app-password>

# Comma-separated exact frontend/admin origins (no wildcards)
CORS_ORIGINS=https://shop.example.com,https://admin.example.com

# Number of trusted reverse proxies in front of this app (1 is typical)
TRUST_PROXY=1

# Optional app-level HTTPS enforcement (reverse proxy should also redirect)
FORCE_HTTPS=false
PUBLIC_HOST=api.example.com

# Optional tuning
DELIVERY_FEE=80
BCRYPT_ROUNDS=12
GLOBAL_RATE_LIMIT=300
LOGIN_RATE_LIMIT=10
ADMIN_LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5
OTP_REQUEST_RATE_LIMIT=3
OTP_VERIFY_RATE_LIMIT=10
CART_RATE_LIMIT=120
ORDER_RATE_LIMIT=20
